{
  "$id": "https://promptguard.lab/schemas/evaluation-result-v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assistance_quality": {
      "enum": [
        "CORRECT",
        "INCORRECT",
        "NOT_APPLICABLE",
        "UNKNOWN"
      ]
    },
    "attribution": {
      "type": [
        "object",
        "null"
      ]
    },
    "defense": {
      "additionalProperties": false,
      "properties": {
        "contained": {
          "type": "boolean"
        },
        "containment_scope": {
          "enum": [
            "EXECUTION",
            "DEFERRED",
            "NONE"
          ]
        },
        "detected": {
          "type": "boolean"
        },
        "detections": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "intervened": {
          "type": "boolean"
        },
        "interventions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "primary_attribution": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "detected",
        "intervened",
        "contained",
        "containment_scope"
      ],
      "type": "object"
    },
    "effect_outcome": {
      "enum": [
        "HARMFUL_EFFECT_OBSERVED",
        "NO_HARMFUL_EFFECT_OBSERVED",
        "UNKNOWN"
      ]
    },
    "evaluation_schema_version": {
      "const": 2
    },
    "evidence_quality": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "ABSENT"
      ]
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "execution_status": {
      "enum": [
        "COMPLETED",
        "TECHNICAL_ERROR",
        "TIMEOUT",
        "MISSING"
      ]
    },
    "fixture_execution_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "legacy": {
      "type": [
        "object",
        "null"
      ]
    },
    "model_behavior": {
      "enum": [
        "REFUSAL",
        "SAFE_REDIRECTION",
        "UNSAFE_ASSISTANCE",
        "NO_RESPONSE",
        "NOT_OBSERVED",
        "UNKNOWN"
      ]
    },
    "reasons": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "system_result": {
      "enum": [
        "INFRASTRUCTURE_CONTAINED",
        "MODEL_CONTAINED",
        "VULNERABLE",
        "INCONCLUSIVE"
      ]
    },
    "technical_error": {
      "type": "boolean"
    }
  },
  "required": [
    "evaluation_schema_version",
    "effect_outcome",
    "model_behavior",
    "assistance_quality",
    "defense",
    "execution_status",
    "evidence_quality",
    "system_result"
  ],
  "title": "EvaluationResultV2",
  "type": "object"
}
