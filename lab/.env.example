# PromptGuard FinTech Lab - plantilla de entorno
#
# Copia este archivo a .env y ajusta el proveedor que quieras usar:
#   cp .env.example .env
#
# Modos soportados:
#   - ollama     -> modelo local en el host
#   - openrouter -> API cloud
#   - custom     -> cualquier endpoint OpenAI-compatible

# ============================================================
# CONFIG GENERAL
# ============================================================
APP_MODE=vulnerable
# Endpoint de chat que usa el front normal (index.html).
# Valores: simple-prompt | complex-prompt | complex-with-context
CHAT_ENDPOINT=complex-with-context
LOG_LEVEL=INFO
LLM_PROVIDER=ollama

# Puertos expuestos en el host (cambia si hay conflicto)
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ============================================================
# OLLAMA
# ============================================================
# Default razonable para un equipo que usa el lab de forma local.
# Cambia el modelo si ya tienes otro descargado.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# Local (sin Docker): qwen3.5:9b  |  Docker Ollama (profile ollama): qwen3.5:4b
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_API_KEY=ollama

# ============================================================
# OPENROUTER
# ============================================================
# Obtén tu API key en https://openrouter.ai/keys
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_API_KEY=sk-or-v1-TU_API_KEY_AQUI

# ============================================================
# JUDGE LLM (evalúa fixtures con resultado UNKNOWN)
# ============================================================
# Modelo local pequeño. El script run_attack_suite.py lo usa como fallback
# cuando los keywords no son concluyentes (UNKNOWN).
JUDGE_BASE_URL=http://localhost:11434/v1
JUDGE_MODEL=qwen3.5:2b

# ============================================================
# PROXY CUSTOM OPCIONAL
# ============================================================
# Útil si luego quieres interponer LiteLLM o cualquier proxy compatible.
LLM_BASE_URL=http://localhost:4000/v1
LLM_MODEL=clara-local
LLM_API_KEY=sk-local

# ============================================================
# LÍMITES DE INFRAESTRUCTURA (LLM10:2025 — Unbounded Consumption)
# ============================================================
# Solo aplican en /chat/proxy, y se saltan con vulnerable=True — ver
# docs/defensas/LLM10-unbounded-consumption/. Valores por defecto si se omiten:
# los mismos que aquí.
CLARA_MAX_OUTPUT_TOKENS=1024
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
BUDGET_GUARD_TOKEN_LIMIT=20000
BUDGET_GUARD_WINDOW_SECONDS=3600
SESSION_STORE_MAX_SESSIONS=1000
SESSION_STORE_TTL_SECONDS=1800
