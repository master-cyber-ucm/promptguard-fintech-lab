{
  "rest": {
    "RestGenerator": {
      "name": "clara",
      "uri": "http://localhost:8000/api/v1/chat/simple-prompt",
      "method": "post",
      "headers": {
        "Content-Type": "application/json"
      },
      "req_template_json_object": {
        "prompt": "$INPUT",
        "user_id": "garak-redteam"
      },
      "response_json": true,
      "response_json_field": "response",
      "request_timeout": 300
    }
  }
}