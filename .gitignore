# Audit session files (generated, not committed)
lab/audit/

# Informes intermedios del agente de red-team; los Run Folders auditados son la
# evidencia canónica y estos cuadernos se regeneran en cada Campaña.
lab/redteam-agent/ejercicios/*/[0-9]*_redteam-agent.md

# Memoria persistente entre Campañas del agente de red-team (--seed-source
# memoria): estado local acumulado, distinto de sources/data/garak_seeds.json
# (dataset fijo generado una vez y sí versionado).
lab/redteam-agent/sources/data/memoria.json

# Documentos Word del TFM (edición local, fuera del repo)
*.docx
!lab/payloads/*.docx
.~lock.*#

# Base de datos del SOC: telemetría local, se regenera con el tráfico
lab/audit/soc.db
lab/audit/soc.db-wal
lab/audit/soc.db-shm

# Configuración local de la skill de diseño (no forma parte del proyecto)
.impeccable/
